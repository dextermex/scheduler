# PostgreSQL connection string.
# On Railway: add a Postgres service and reference it, e.g.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/aura_scheduler"

# Shared password for the site. If unset, the site is open (no login).
APP_PASSWORD="change-me"

# Discord webhook that receives the "ON SHIFT :" pings.
# Can also be set later on the /settings page (the DB value wins).
DISCORD_WEBHOOK_URL=""

# Optional: secret for the external cron fallback endpoint
#   GET /api/cron/shift-ping?secret=...
# The built-in scheduler makes this optional; only needed if you prefer an
# external cron (e.g. cron-job.org) to trigger pings.
CRON_SECRET=""

# Shared token for the app-to-app sync API (GET /api/models), used by OpsTrack
# to read the creator roster. Set the SAME value on the OpsTrack (argus) Railway
# service. Unset = the sync endpoint is disabled.
SCHEDULER_SYNC_TOKEN=""

# OpsTrack base URL, for the app-to-app link (SSO into the embedded tab and
# creator avatars via OpsTrack's public avatar proxy). Default is production.
OPSTRACK_URL="https://opstrack.auramngt.com"
